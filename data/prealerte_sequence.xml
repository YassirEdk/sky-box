<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="seq_skybox_prealerte" model="ir.sequence">
        <field name="name">Prealerte Skybox</field>
        <field name="code">skybox.prealerte</field>
        <field name="prefix">PA</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <record id="seq_skybox_tracking" model="ir.sequence">
        <field name="name">Tracking Skybox</field>
        <field name="code">skybox.tracking</field>
        <field name="prefix">S</field>
        <field name="padding">4</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

    <!-- Quelques transporteurs de depart -->
    <record id="courier_dhl" model="skybox.courier">
        <field name="name">DHL</field>
        <field name="code">COU-001</field>
    </record>
    <record id="courier_fedex" model="skybox.courier">
        <field name="name">FedEx</field>
        <field name="code">COU-002</field>
    </record>
    <record id="courier_ups" model="skybox.courier">
        <field name="name">UPS</field>
        <field name="code">COU-003</field>
    </record>
</odoo>
