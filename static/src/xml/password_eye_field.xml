<?xml version="1.0" encoding="UTF-8" ?>
<templates xml:space="preserve">
    <t t-name="skybox.PasswordEyeField">
        <div class="o_field_password_eye d-flex align-items-center w-100" style="min-width: 320px;">
            <t t-if="props.readonly">
                <span t-esc="eyeState.reveal ? displayValue : '••••••••'"/>
            </t>
            <t t-else="">
                <input
                    class="o_input flex-grow-1"
                    t-att-type="eyeState.reveal ? 'text' : 'password'"
                    t-att-value="displayValue"
                    t-att-placeholder="props.placeholder"
                    t-on-change="onChange"
                    autocomplete="new-password"
                />
            </t>
            <button
                class="btn btn-link p-0 ms-1"
                type="button"
                tabindex="-1"
                t-att-title="eyeState.reveal ? 'Masquer' : 'Afficher'"
                t-on-click="() => this.toggleReveal()"
            >
                <i t-att-class="eyeState.reveal ? 'fa fa-eye-slash' : 'fa fa-eye'"/>
            </button>
            <button
                class="btn btn-link p-0 ms-1"
                type="button"
                tabindex="-1"
                title="Copier"
                t-on-click="() => this.copyValue()"
            >
                <i class="fa fa-clipboard"/>
            </button>
        </div>
    </t>
</templates>
