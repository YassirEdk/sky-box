<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_skybox_check_tn_wizard_form" model="ir.ui.view">
        <field name="name">skybox.check.tn.wizard.form</field>
        <field name="model">skybox.check.tn.wizard</field>
        <field name="arch" type="xml">
            <form string="Resultat Check TN">
                <div class="alert alert-info" role="status">
                    <field name="summary"/>
                </div>
                <field name="line_ids" readonly="1">
                    <list string="Resultats" create="false" delete="false"
                          decoration-success="prealerte_id or status == 'ALREADY_PROCESSED'"
                          decoration-warning="not prealerte_id and status == 'PREALERT_NOT_FOUND'"
                          decoration-danger="not prealerte_id and status not in ('PREALERT_NOT_FOUND', 'PREALERT_FOUND', 'ALREADY_PROCESSED')">
                        <field name="tracking_number"/>
                        <field name="status"/>
                        <field name="prealerte_id"/>
                        <field name="skybill"/>
                        <field name="courier"/>
                        <field name="declared_value"/>
                        <field name="currency"/>
                        <field name="message"/>
                    </list>
                </field>
                <footer>
                    <button string="Fermer" class="btn-primary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
