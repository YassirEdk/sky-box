<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Kanban Bags : icone + nom + nombre de commandes dans le bag -->
    <record id="view_skybox_bag_kanban" model="ir.ui.view">
        <field name="name">skybox.bag.kanban</field>
        <field name="model">stock.quant.package</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <kanban quick_create="false" create="true">
                <field name="name"/>
                <field name="skybox_order_count"/>
                <field name="skybox_open_state"/>
                <templates>
                    <t t-name="kanban-box">
                        <t t-set="full" t-value="record.skybox_order_count.raw_value > 0"/>
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click o_skybox_card o_skybox_bag_card o_skybox_card--#{full ? 'info' : 'secondary'}">
                            <div class="o_skybox_bag_icon">
                                <i t-attf-class="fa #{full ? 'fa-shopping-bag' : 'fa-shopping-bag opacity-50'}"
                                   title="Bag"/>
                            </div>
                            <div class="o_skybox_bag_info">
                                <span class="o_skybox_ref"><field name="name"/></span>
                                <small t-if="full" class="text-info">
                                    <i class="fa fa-circle me-1" title="En cours"/>En cours
                                </small>
                                <small t-else="" class="text-muted">
                                    <i class="fa fa-circle-o me-1" title="Vide"/>Vide
                                </small>
                                <small t-if="record.skybox_open_state.raw_value == 'open'" class="text-success">
                                    <i class="fa fa-unlock me-1" title="Ouvert"/>Ouvert (reception)
                                </small>
                                <small t-elif="record.skybox_open_state.raw_value == 'processing'" class="text-warning">
                                    <i class="fa fa-cogs me-1" title="Traitement"/>Ouvert (traitement)
                                </small>
                                <small t-else="" class="text-muted">
                                    <i class="fa fa-lock me-1" title="Ferme"/>Ferme
                                </small>
                            </div>
                            <div class="o_skybox_bag_count">
                                <span t-attf-class="o_skybox_bag_num #{full ? 'text-info' : 'text-muted'}">
                                    <field name="skybox_order_count"/>
                                </span>
                                <small class="text-muted">article(s)</small>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Liste Bags -->
    <record id="view_skybox_bag_list" model="ir.ui.view">
        <field name="name">skybox.bag.list</field>
        <field name="model">stock.quant.package</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <list string="Bags">
                <field name="name"/>
                <field name="skybox_bag_type_id" optional="show"/>
                <field name="skybox_order_count" string="Articles"/>
                <field name="skybox_open_state" widget="badge"
                       decoration-success="skybox_open_state == 'open'"
                       decoration-warning="skybox_open_state == 'processing'"
                       decoration-muted="skybox_open_state == 'closed'"/>
                <field name="skybox_opened_by_label" optional="show"/>
                <field name="skybox_opened_at" optional="show"/>
                <field name="skybox_closed_by_label" optional="show"/>
                <field name="skybox_closed_at" optional="show"/>
            </list>
        </field>
    </record>

    <!-- Detail Bag : commandes encore dans le bag -->
    <record id="view_skybox_bag_form" model="ir.ui.view">
        <field name="name">skybox.bag.form</field>
        <field name="model">stock.quant.package</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <form string="Bag">
                <header>
                    <button name="action_skybox_open" type="object" string="Ouvrir"
                            class="btn-primary" invisible="skybox_open_state != 'closed'"/>
                    <button name="action_skybox_close" type="object" string="Fermer"
                            class="btn-primary" invisible="skybox_open_state == 'closed'"/>
                    <field name="skybox_open_state" widget="statusbar"
                           statusbar_visible="closed,open,processing"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <div class="oe_stat_button" style="cursor: default;">
                            <i class="fa fa-fw fa-shopping-bag o_button_icon" title="Articles"/>
                            <div class="o_stat_info">
                                <span class="o_stat_value">
                                    <field name="skybox_order_count"/>
                                </span>
                                <span class="o_stat_text">Articles</span>
                            </div>
                        </div>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Bag"/>
                        <h1>
                            <i class="fa fa-shopping-bag me-2 text-info" title="Bag"/>
                            <field name="name" class="d-inline-block w-auto"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="skybox_bag_type_id"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="skybox_opened_by_label"/>
                            <field name="skybox_opened_at"/>
                        </group>
                        <group>
                            <field name="skybox_closed_by_label"/>
                            <field name="skybox_closed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Commandes dans le bag" name="orders">
                            <field name="skybox_order_ids" readonly="1" nolabel="1">
                                <list string="Commandes" create="0" delete="0">
                                    <field name="name" string="Reference"/>
                                    <field name="tracking_number"/>
                                    <field name="client_id"/>
                                    <field name="client_ref" optional="show"/>
                                    <field name="courier_id" optional="hide"/>
                                    <field name="create_date" string="Recu le" optional="show"/>
                                    <field name="create_uid" string="Agent" optional="show"/>
                                    <field name="prealerte_status" widget="badge"
                                           decoration-warning="prealerte_status == 'ready_to_match'"
                                           decoration-success="prealerte_status == 'matched'"
                                           decoration-danger="prealerte_status == 'not_found'"/>
                                </list>
                            </field>
                        </page>
                        <page string="Suivi Skybox" name="skybox_progress">
                            <group>
                                <group string="Traitement">
                                    <field name="skybox_bag_status"/>
                                    <field name="skybox_session_id"/>
                                    <field name="skybox_warehouse_code"/>
                                    <field name="skybox_started_at"/>
                                    <field name="skybox_started_by"/>
                                    <field name="skybox_completed_at"/>
                                    <field name="skybox_completed_by"/>
                                    <field name="skybox_detail_level"/>
                                    <field name="skybox_last_event_id"/>
                                </group>
                                <group string="Compteurs">
                                    <field name="skybox_expected"/>
                                    <field name="skybox_processed"/>
                                    <field name="skybox_set_aside"/>
                                    <field name="skybox_missing"/>
                                    <field name="skybox_unexpected_kept"/>
                                    <field name="skybox_unexpected_set_aside"/>
                                    <field name="skybox_pending_identification"/>
                                    <field name="skybox_remaining"/>
                                </group>
                            </group>
                            <group string="Trackings restants"
                                   invisible="not skybox_remaining_tracking_numbers">
                                <field name="skybox_remaining_tracking_numbers" nolabel="1" colspan="2"/>
                            </group>
                            <group string="Colis (JSON Skybox)"
                                   invisible="not skybox_parcels_json or skybox_parcels_json == '[]'">
                                <field name="skybox_parcels_json" nolabel="1" colspan="2"
                                       class="font-monospace"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Recherche Bags -->
    <record id="view_skybox_bag_search" model="ir.ui.view">
        <field name="name">skybox.bag.search</field>
        <field name="model">stock.quant.package</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <search string="Bags">
                <field name="name" string="Bag"/>
                <field name="skybox_bag_type_id"/>
                <field name="skybox_order_ids" string="Tracking"
                       filter_domain="[('skybox_order_ids.tracking_number', 'ilike', self)]"/>
                <filter name="with_orders" string="Avec commandes"
                        domain="[('skybox_order_ids', '!=', False)]"/>
                <filter name="empty" string="Vides"
                        domain="[('skybox_order_ids', '=', False)]"/>
                <separator/>
                <filter name="open" string="Ouverts (reception)"
                        domain="[('skybox_open_state', '=', 'open')]"/>
                <filter name="processing" string="Ouverts (traitement)"
                        domain="[('skybox_open_state', '=', 'processing')]"/>
                <filter name="closed" string="Fermes"
                        domain="[('skybox_open_state', '=', 'closed')]"/>
                <group expand="0" string="Regrouper par">
                    <filter name="group_open_state" string="Etat"
                            context="{'group_by': 'skybox_open_state'}"/>
                    <filter name="group_bag_type" string="Type de bag"
                            context="{'group_by': 'skybox_bag_type_id'}"/>
                </group>
            </search>
        </field>
    </record>

</odoo>
