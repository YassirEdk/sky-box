<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_location_form_skybox_barcode" model="ir.ui.view">
        <field name="name">stock.location.form.skybox.barcode</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="before">
                <header>
                    <button name="%(stock.action_report_location_barcode)d"
                            string="Imprimer code-barres" type="action"
                            class="btn-primary" icon="fa-barcode"
                            invisible="not barcode"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='usage']" position="before">
                <field name="barcode" placeholder="Auto : nom de l'emplacement"/>
            </xpath>
        </field>
    </record>

    <record id="view_location_tree2_skybox_barcode" model="ir.ui.view">
        <field name="name">stock.location.list.skybox.barcode</field>
        <field name="model">stock.location</field>
        <field name="inherit_id" ref="stock.view_location_tree2"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="barcode" optional="show"/>
            </xpath>
        </field>
    </record>

</odoo>
